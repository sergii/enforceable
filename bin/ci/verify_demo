#!/usr/bin/env bash
set -euo pipefail

binding="${1:?pass pundit, action_policy, or cancancan}"

if [[ "$binding" == "cancancan" ]]; then
  output=$(BINDING="$binding" bundle exec rake demo 2>&1)
  echo "$output"
  grep -q 'no divergences' <<<"$output"
  exit 0
fi

if output=$(BINDING="$binding" bundle exec rake demo 2>&1); then
  echo "Demo unexpectedly passed"
  exit 1
fi

echo "$output"
grep -q 'DATA EXPOSURE.*recruiter / confidential_job_application' <<<"$output"
test "$(grep -c 'DATA EXPOSURE' <<<"$output")" -eq 1
